# ============================================================================
# TODAY SHAWARMA - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local
# ============================================================================

# ----------------------------------------------------------------------------
# SUPABASE (Required)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ----------------------------------------------------------------------------
# GOOGLE PLACES API (For Reviews)
# Get API Key: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API
# Get Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
# ----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_PLACE_ID=your-google-place-id

# To find your Place ID:
# 1. Go to: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
# 2. Search for "Today Shawarma Edinburgh" or your business name
# 3. Click on your business and copy the Place ID (starts with "ChIJ...")
